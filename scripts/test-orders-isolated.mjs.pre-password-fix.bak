import { spawn } from 'node:child_process';
import { randomUUID } from 'node:crypto';
import { fileURLToPath } from 'node:url';
import { dirname, resolve } from 'node:path';

// Deliberately restricted to a fresh PostgreSQL database on loopback.
// This runner never reads .env or accepts a Supabase URL.
const root = resolve(dirname(fileURLToPath(import.meta.url)), '..');
const database = process.env.SHIBOSS_TEST_DB_NAME;
const user = process.env.SHIBOSS_TEST_DB_USER;
const port = process.env.SHIBOSS_TEST_DB_PORT ?? '5432';
const psql = process.env.SHIBOSS_TEST_PSQL ?? 'psql';
if (!/^shiboss_test(?:_[a-z0-9_]+)?$/.test(database ?? '') || !/^[a-z_][a-z0-9_]*$/.test(user ?? '')
  || !/^[0-9]{2,5}$/.test(port) || Number(port) > 65535) {
  console.error('BELUM DIJALANKAN: set SHIBOSS_TEST_DB_NAME=shiboss_test dan SHIBOSS_TEST_DB_USER untuk database lokal khusus uji.');
  process.exit(2);
}

const pgEnv = { ...process.env };
for (const name of ['PGHOST', 'PGHOSTADDR', 'PGPORT', 'PGDATABASE', 'PGUSER', 'PGSERVICE', 'PGSERVICEFILE', 'PGOPTIONS']) delete pgEnv[name];
pgEnv.PGCONNECT_TIMEOUT = '3';
const base = ['-X', '-qAt', '-w', '-h', '127.0.0.1', '-p', port, '-U', user, '-d', database,
  '-v', 'ON_ERROR_STOP=1', '-v', 'VERBOSITY=verbose'];

function psqlRun({ sql, file } = {}) {
  return new Promise((done) => {
    const args = [...base, ...(file ? ['-f', resolve(root, file)] : ['-c', sql])];
    const child = spawn(psql, args, { env: pgEnv, windowsHide: true });
    let stdout = ''; let stderr = '';
    child.stdout.on('data', (part) => { stdout += part; });
    child.stderr.on('data', (part) => { stderr += part; });
    child.on('error', (error) => done({ ok: false, code: error.code ?? 'SPAWN', stdout: '', stderr: '' }));
    child.on('close', (code) => done({ ok: code === 0, code, stdout: stdout.trim(), stderr: stderr.trim() }));
  });
}
function sqlstate(result) { return result.stderr.match(/\b(?:ERROR|FATAL|PANIC):\s+([0-9A-Z]{5}):/)?.[1] ?? 'unknown'; }
async function required(label, args) {
  const result = await psqlRun(args);
  if (!result.ok) throw new Error(`${label}: gagal (${sqlstate(result)})`);
  console.log(`LULUS ${label}`);
  return result.stdout;
}
async function rejected(label, sql, expectedCode) {
  const result = await psqlRun({ sql });
  if (result.ok || sqlstate(result) !== expectedCode) throw new Error(`${label}: perlu ${expectedCode}, diperoleh ${result.ok ? 'berhasil' : sqlstate(result)}`);
  console.log(`LULUS ${label}`);
}
async function json(label, sql) { return JSON.parse(await required(label, { sql })); }
function asAnon(sql) { return `begin; set local role anon; ${sql}; commit;`; }
function asAuthenticated(sql) { return `begin; set local role authenticated; ${sql}; commit;`; }
const menuA = '00000000-0000-4000-8000-000000000101';
const menuB = '00000000-0000-4000-8000-000000000102';
const menuOff = '00000000-0000-4000-8000-000000000103';
const items = [{ menu_item_id: menuA, quantity: 1 }, { menu_item_id: menuB, quantity: 1 }];
const oneItem = [{ menu_item_id: menuA, quantity: 1 }];
function call(key, rows = items, total = 30, name = 'Pelanggan Uji') {
  return `select public.create_table_order('${name}', '7', null, '${JSON.stringify(rows)}'::jsonb, ${total}, '${key}'::uuid)::text`;
}
function countFor(key) {
  return `select jsonb_build_object('orders',(select count(*) from public.orders where idempotency_key='${key}'),
    'items',(select count(*) from public.order_items where order_id in (select id from public.orders where idempotency_key='${key}')),
    'payments',(select count(*) from public.payments where order_id in (select id from public.orders where idempotency_key='${key}')))::text`;
}
function assert(condition, label) { if (!condition) throw new Error(label); console.log(`LULUS ${label}`); }

try {
  const identity = await json('koneksi database lokal', "select jsonb_build_object('database',current_database(),'host',host(inet_server_addr()),'user',current_user)::text");
  assert(identity.database === database && ['127.0.0.1', '::1'].includes(identity.host) && identity.user === user,
    'target loopback dan nama database sesuai');
  const objects = Number(await required('periksa isi database', { sql: `select count(*) from pg_class c join pg_namespace n on n.oid=c.relnamespace
    where c.relkind in ('r','p','v','m','f') and n.nspname not in ('pg_catalog','information_schema')
    and n.nspname not like 'pg_toast%'` }));
  assert(objects === 0, 'belum ada tabel atau view aplikasi');

  await required('bootstrap role dan auth sintetis', { file: 'supabase/tests/bootstrap_isolated.sql' });
  await required('migrasi menu pada database uji', { file: 'supabase/migrations/202610240001_menu_items.sql' });
  await required('migrasi pesanan pada database uji', { file: 'supabase/migrations/202610250001_customer_orders.sql' });

  for (const table of ['profiles', 'orders', 'order_items', 'payments']) {
    const meta = await json(`RLS dan grant ${table}`, `select jsonb_build_object('rls',c.relrowsecurity,
      'policies',(select count(*) from pg_policy where polrelid=c.oid),
      'anon_select',has_table_privilege('anon',c.oid,'SELECT'),
      'anon_insert',has_table_privilege('anon',c.oid,'INSERT'),
      'anon_update',has_table_privilege('anon',c.oid,'UPDATE'),
      'anon_delete',has_table_privilege('anon',c.oid,'DELETE'),
      'auth_select',has_table_privilege('authenticated',c.oid,'SELECT'),
      'auth_insert',has_table_privilege('authenticated',c.oid,'INSERT'),
      'auth_update',has_table_privilege('authenticated',c.oid,'UPDATE'),
      'auth_delete',has_table_privilege('authenticated',c.oid,'DELETE'))::text
      from pg_class c where c.oid='public.${table}'::regclass`);
    assert(meta.rls && Number(meta.policies) === 0 && !meta.anon_select && !meta.anon_insert
      && !meta.anon_update && !meta.anon_delete && !meta.auth_select && !meta.auth_insert
      && !meta.auth_update && !meta.auth_delete,
    `tidak ada akses tabel publik: ${table}`);
    await rejected(`anon SELECT ${table}`, asAnon(`select count(*) from public.${table}`), '42501');
    await rejected(`authenticated SELECT ${table}`, asAuthenticated(`select count(*) from public.${table}`), '42501');
  }
  await rejected('anon INSERT orders', asAnon(`insert into public.orders default values`), '42501');
  await rejected('anon UPDATE orders', asAnon(`update public.orders set customer_name='X'`), '42501');
  await rejected('anon DELETE orders', asAnon(`delete from public.orders`), '42501');
  await rejected('authenticated INSERT orders', asAuthenticated(`insert into public.orders default values`), '42501');
  await rejected('authenticated UPDATE orders', asAuthenticated(`update public.orders set customer_name='X'`), '42501');
  await rejected('authenticated DELETE orders', asAuthenticated(`delete from public.orders`), '42501');

  const indexes = await json('indeks dan foreign key', `select jsonb_build_object(
    'indexes',(select jsonb_agg(indexname) from pg_indexes where schemaname='public'
      and tablename in ('orders','order_items','payments')),
    'foreign_keys',(select count(*) from pg_constraint where contype='f'
      and conrelid in ('public.profiles'::regclass,'public.orders'::regclass,
      'public.order_items'::regclass,'public.payments'::regclass)))::text`);
  assert(['orders_pkey','orders_order_number_key','orders_idempotency_key_key',
    'orders_created_at_idx','order_items_order_id_idx','payments_status_idx']
    .every((name) => indexes.indexes.includes(name)) && Number(indexes.foreign_keys) >= 6,
  'indeks dan foreign key dasar ada');

  const privileges = await json('owner, SECURITY DEFINER, search_path dan EXECUTE', `select jsonb_build_object(
    'owner',pg_get_userbyid(private.proowner),'private_definer',private.prosecdef,
    'private_config',private.proconfig,'public_definer',wrapper.prosecdef,'public_config',wrapper.proconfig,
    'anon_private',has_function_privilege('anon',private.oid,'EXECUTE'),
    'anon_public',has_function_privilege('anon',wrapper.oid,'EXECUTE'),
    'auth_private',has_function_privilege('authenticated',private.oid,'EXECUTE'),
    'auth_public',has_function_privilege('authenticated',wrapper.oid,'EXECUTE'))::text
    from pg_proc private cross join pg_proc wrapper
    where private.oid='shiboss_private.create_table_order(text,text,text,jsonb,numeric,uuid)'::regprocedure
    and wrapper.oid='public.create_table_order(text,text,text,jsonb,numeric,uuid)'::regprocedure`);
  assert(privileges.owner === user && privileges.private_definer && !privileges.public_definer
    && privileges.private_config.includes('search_path=') && privileges.public_config.includes('search_path=')
    && privileges.anon_private && privileges.anon_public && !privileges.auth_private && !privileges.auth_public,
  'fungsi dan grants sesuai rancangan');
  await rejected('authenticated tidak dapat menjalankan RPC', asAuthenticated(call(randomUUID(), oneItem, 10)), '42501');

  await required('seed menu sintetis khusus database uji', { sql: `insert into public.menu_items(id,name,category,price,is_available) values
    ('${menuA}','Produk Uji A','Uji',10,true),('${menuB}','Produk Uji B','Uji',20,true),
    ('${menuOff}','Produk Uji Nonaktif','Uji',30,false)` });
  const key = randomUUID();
  const saved = await json('pesanan atomik dua item', asAnon(call(key)));
  const counts = await json('hitung hasil transaksi', countFor(key));
  assert(saved.total_amount === 30 && saved.items.length === 2 && saved.payment_status === 'pending'
    && saved.payment_method === 'qris' && Number(counts.orders) === 1 && Number(counts.items) === 2
    && Number(counts.payments) === 1, 'pesanan, dua item dan pembayaran pending tersimpan bersama');
  const replay = await json('replay kunci sama', asAnon(call(key)));
  assert(JSON.stringify(replay) === JSON.stringify(saved), 'replay mengembalikan receipt sama');
  await rejected('konflik kunci idempotensi', asAnon(call(key, items, 30, 'Nama Berbeda')), 'P0001');
  const cross = await json('hitung setelah replay dan konflik', countFor(key));
  assert(Number(cross.orders) === 1 && Number(cross.items) === 2, 'replay tidak menggandakan pesanan');
  await rejected('pelanggan lain tidak bisa meminta receipt via kunci sama dengan payload berbeda',
    asAnon(call(key, items, 30, 'Pelanggan Lain')), 'P0001');

  for (const [label, rows, total, code] of [
    ['harga dimanipulasi', oneItem, 1, 'P0001'],
    ['produk nonaktif', [{ menu_item_id: menuOff, quantity: 1 }], 30, 'P0001'],
    ['jumlah nol', [{ menu_item_id: menuA, quantity: 0 }], 10, '22023'],
    ['jumlah terlalu besar', [{ menu_item_id: menuA, quantity: 2147483648 }], 10, '22023'],
  ]) {
    const rejectedKey = randomUUID();
    await rejected(label, asAnon(call(rejectedKey, rows, total)), code);
    const after = await json(`rollback ${label}`, countFor(rejectedKey));
    assert(Number(after.orders) === 0 && Number(after.items) === 0 && Number(after.payments) === 0,
      `tanpa baris parsial: ${label}`);
  }

  const failedKey = randomUUID();
  await required('pasang trigger gagal item sintetis', { sql: `create function public.reject_test_item() returns trigger language plpgsql as $$
    begin if new.menu_item_id='${menuB}' then raise exception 'TEST_ITEM_FAILURE'; end if; return new; end $$;
    create trigger reject_test_item before insert on public.order_items for each row execute function public.reject_test_item()` });
  try {
    await rejected('gagal pada item kedua', asAnon(call(failedKey)), 'P0001');
    const after = await json('hasil rollback item kedua', countFor(failedKey));
    assert(Number(after.orders) === 0 && Number(after.items) === 0 && Number(after.payments) === 0,
      'rollback seluruh transaksi ketika satu item gagal');
  } finally {
    await required('hapus trigger uji', { sql: 'drop trigger reject_test_item on public.order_items; drop function public.reject_test_item()' });
  }

  const concurrentKey = randomUUID();
  const simultaneous = await Promise.all([psqlRun({ sql: asAnon(call(concurrentKey)) }), psqlRun({ sql: asAnon(call(concurrentKey)) })]);
  assert(simultaneous.every((result) => result.ok), 'dua request serentak selesai tanpa error');
  const receipts = simultaneous.map((result) => JSON.parse(result.stdout));
  const concurrentCount = await json('hitung hasil request serentak', countFor(concurrentKey));
  assert(receipts[0].order_number === receipts[1].order_number && Number(concurrentCount.orders) === 1
    && Number(concurrentCount.items) === 2 && Number(concurrentCount.payments) === 1,
  'request serentak dengan key sama hanya membuat satu pesanan');

  await rejected('status pesanan di luar daftar', `update public.orders set order_status='unknown' where idempotency_key='${key}'`, '23514');
  await rejected('status paid tanpa verifikasi', `update public.payments set payment_status='paid'
    where order_id=(select id from public.orders where idempotency_key='${key}')`, '23514');
  const admin = randomUUID();
  await required('simulasi admin di database uji', { sql: `insert into auth.users(id) values('${admin}');
    insert into public.profiles(id,full_name,role) values('${admin}','Admin Uji','admin');
    update public.orders set order_status='confirmed' where idempotency_key='${key}';
    update public.payments set payment_status='paid',verified_by='${admin}',verified_at=now()
    where order_id=(select id from public.orders where idempotency_key='${key}')` });
  const updated = await json('replay setelah verifikasi sintetis', asAnon(call(key)));
  assert(updated.order_status === 'confirmed' && updated.payment_status === 'paid',
    'status pesanan dan pembayaran tetap terpisah pada replay');

  for (let i = 0; i < 3; i++) await required(`RPC anonim berbeda ${i + 1}`, { sql: asAnon(call(randomUUID(), oneItem, 10)) });
  console.log('RISIKO: tiga kunci berbeda diterima; rancangan belum memiliki rate limiting RPC langsung.');
  console.log('SELESAI: semua pengujian PostgreSQL lokal lulus. Database uji dibiarkan untuk inspeksi manual.');
} catch (error) {
  console.error(`GAGAL: ${error.message}`);
  process.exitCode = 1;
}
