---
import MainLayout from '../../layouts/MainLayout.astro';import ProductCard from '../../components/ProductCard.astro';import MenuState from '../../components/MenuState.astro';import {loadMenu} from '../../lib/services/menu';
const result=await loadMenu();const categories=[...new Set(result.items.map(item=>item.category))];Astro.response.headers.set('Cache-Control','no-store');if(result.status!=='ready')Astro.response.status=503;
---
<MainLayout title="Menu">
  <section class="menu-top"><div class="container"><p class="breadcrumb"><a href="/">Beranda</a><span aria-hidden="true"> / </span>Menu</p><div class="page-heading"><p class="eyebrow">Katalog Shiboss</p><h1>Pilih menu yang cocok untukmu.</h1><p>Cari produk, lihat harga terbaru, dan simpan pilihan di keranjang.</p></div>
    {result.status==='ready'&&result.items.length>0&&<><form class="menu-filters" role="search" onsubmit="return false" hidden data-filters><div><label for="search">Cari menu</label><input id="search" type="search" placeholder="Cari nama produk" autocomplete="off"/></div><div><label for="category">Kategori</label><select id="category"><option value="">Semua menu</option>{categories.map(category=><option value={category}>{category}</option>)}</select></div><div><label for="sort">Urutkan</label><select id="sort"><option value="name">Nama A–Z</option><option value="price-asc">Harga terendah</option><option value="price-desc">Harga tertinggi</option></select></div></form><div class="category-tabs" hidden data-category-tabs aria-label="Pilih kategori"><button type="button" data-category-value="" aria-pressed="true">Semua <span>{result.items.length}</span></button>{categories.map(category=><button type="button" data-category-value={category} aria-pressed="false">{category}</button>)}</div></>}
  </div></section>
  <section class="container menu-page">{result.status==='ready'&&result.items.length>0?<><p id="result-count" class="result-count" role="status">{result.items.length} menu tersedia</p><p class="sr-only" role="status" data-cart-feedback></p><div class="product-grid" data-product-grid>{result.items.map(item=><ProductCard item={item}/>)}</div><section id="no-results" class="menu-state" hidden><h2>Menu tidak ditemukan</h2><p>Coba nama lain atau tampilkan semua kategori.</p><button class="button secondary" id="reset">Reset pencarian</button></section></>:<MenuState status={result.status==='ready'?'empty':result.status}/>}</section>
</MainLayout><script>import '../../scripts/menu';</script>
