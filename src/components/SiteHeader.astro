---
const pathname = Astro.url.pathname;
---
<header class="site-header">
  <div class="container header-inner">
    <a class="identity" href="/" aria-label="Kedai Susu Segar Shiboss, beranda">
      <span class="identity-copy"><strong>Shiboss</strong><small>Kedai Susu Segar</small></span>
    </a>
    <nav class="site-nav" aria-label="Navigasi utama">
      <a href="/" aria-current={pathname === '/' ? 'page' : undefined}>Beranda</a>
      <a href="/menu" aria-current={pathname.startsWith('/menu') ? 'page' : undefined}>Menu</a>
      <a class="nav-cart" href="/cart" aria-current={pathname === '/cart' ? 'page' : undefined}>Keranjang <span class="cart-count" data-cart-count aria-label="Jumlah item di keranjang">0</span></a>
    </nav>
  </div>
</header>
